  consultations     Consultation[]
  triageRecords     TriageRecord[]
  nursingNotes      NursingNote[]
  medicationAdmins  MedicationAdministration[]
  clinicalOrders    ClinicalOrder[]

  @@index([patientId])
  @@index([status])
}

model TriageRecord {
  id                 String              @id @default(uuid())
  visitId            String?
  visit              PatientVisit?       @relation(fields: [visitId], references: [id])
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  queueId            String?             @unique
  queue              ClinicQueue?        @relation(fields: [queueId], references: [id])
  triageCategory     String              @default("NON_URGENT") // EMERGENCY, URGENT, SEMI_URGENT, NON_URGENT
  chiefComplaint     String
  presentingSymptoms String?
  painScore          Int?
  bpSystolic         Int?
  bpDiastolic        Int?
  temperatureC       Float?
  pulseBpm           Int?
  respiratoryRate    Int?
  spo2Percent        Int?
  weightKg           Float?
  heightCm           Float?
  bmi                Float?
  bloodGlucose       Float?
  allergiesReviewed  Boolean             @default(false)
  riskFlags          String?
  notes              String?
  nurseId            String?
  nurse              ClinicStaffProfile? @relation(fields: [nurseId], references: [id])
  nurseName          String?
  triagedAt          DateTime            @default(now())

  @@index([patientId])
  @@index([triageCategory])
}

model NursingNote {
  id         String              @id @default(uuid())
  patientId  String
  patient    Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId    String?
  visit      PatientVisit?       @relation(fields: [visitId], references: [id])
  noteType   String              @default("OBSERVATION") // ASSESSMENT, CARE_PLAN, WOUND_CARE, HANDOVER, OBSERVATION
  content    String
  nurseId    String?
  nurse      ClinicStaffProfile? @relation(fields: [nurseId], references: [id])
  nurseName  String?
  recordedAt DateTime            @default(now())

  @@index([patientId])
}

model MedicationAdministration {
  id                 String        @id @default(uuid())
  patientId          String
  patient            Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId            String?
  visit              PatientVisit? @relation(fields: [visitId], references: [id])
  prescriptionItemId String?
  medicationName     String
  dose               String
  route              String        @default("Oral")
  administeredQty    Int           @default(1)
  status             String        @default("ADMINISTERED") // ADMINISTERED, REFUSED, OMITTED
  omissionReason     String?
  administeredById   String?
  administeredByName String?
  administeredAt     DateTime      @default(now())

  @@index([patientId])
}

model ClinicalFormTemplate {
  id            String                 @id @default(uuid())
  name          String
  departmentId  String?
  department    ClinicDepartment?      @relation(fields: [departmentId], references: [id])
  encounterType String                 @default("OUTPATIENT")
  schemaJson    String                 // JSON array of fields { key, label, type, options, required }
  isActive      Boolean                @default(true)
  createdAt     DateTime               @default(now())
  responses     ClinicalFormResponse[]
}

model ClinicalFormResponse {
  id              String               @id @default(uuid())
  templateId      String
  template        ClinicalFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)
  consultationId  String?
  consultation    Consultation?        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientId       String
  responsesJson   String
  submittedByName String?
  createdAt       DateTime             @default(now())

  @@index([patientId])
  @@index([consultationId])
}

model ClinicalOrder {
  id             String            @id @default(uuid())
  orderNumber    String            @unique
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation?     @relation(fields: [consultationId], references: [id])
  visitId        String?
  visit          PatientVisit?     @relation(fields: [visitId], references: [id])
  orderType      String            // LAB, IMAGING, MEDICATION, PROCEDURE, REFERRAL
  priority       String            @default("ROUTINE") // ROUTINE, URGENT, STAT
  instructions   String?
  status         String            @default("ORDERED") // ORDERED, IN_PROGRESS, COMPLETED, CANCELLED
  departmentId   String?
  department     ClinicDepartment? @relation(fields: [departmentId], references: [id])
  orderedById    String?
  orderedByName  String?
  referenceId    String?           // Link to LabRequest / ImagingRequest / Prescription / ProcedureRecord / Referral
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@index([patientId])
  @@index([orderType, status])
}

model ImagingCatalog {
  id               String           @id @default(uuid())
  code             String           @unique
  name             String
  modality         String           @default("X-Ray") // X-Ray, Ultrasound, ECG, CT, MRI, Other
  description      String?
  preparationNotes String?
  priceGHS         Float            @default(120.0)
  turnaroundHours  Int              @default(24)
  isActive         Boolean          @default(true)
  createdAt        DateTime         @default(now())
  requests         ImagingRequest[]
}

model ImagingRequest {
  id             String         @id @default(uuid())
  requestNumber  String         @unique
  patientId      String
  patient        Patient        @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation?  @relation(fields: [consultationId], references: [id])
  imagingId      String
  imaging        ImagingCatalog @relation(fields: [imagingId], references: [id])
  clinicalNotes  String?
  priority       String         @default("ROUTINE")
  status         String         @default("REQUESTED") // REQUESTED, SCHEDULED, IN_PROGRESS, COMPLETED, REVIEWED, CANCELLED
  scheduledAt    DateTime?
  orderedByName  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  result         ImagingResult?

  @@index([patientId])
  @@index([status])
}

model ImagingResult {
  id              String         @id @default(uuid())
  imagingRequestId String        @unique
  imagingRequest  ImagingRequest @relation(fields: [imagingRequestId], references: [id], onDelete: Cascade)
  findings        String
  impression      String?
  attachmentUrl   String?
  reportedByName  String?
  reviewedByName  String?
  isReleased      Boolean        @default(false)
  reportedAt      DateTime       @default(now())
  reviewedAt      DateTime?
}

model ProcedureCatalog {
  id          String            @id @default(uuid())
  code        String            @unique
  name        String
  category    String            @default("Minor Procedure")
  description String?
  priceGHS    Float             @default(80.0)
  isActive    Boolean           @default(true)
  createdAt   DateTime          @default(now())
  records     ProcedureRecord[]
}

model ProcedureRecord {
  id                   String           @id @default(uuid())
  procedureNumber      String           @unique
  patientId            String
  patient              Patient          @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId       String?
  consultation         Consultation?    @relation(fields: [consultationId], references: [id])
  procedureId          String
  procedure            ProcedureCatalog @relation(fields: [procedureId], references: [id])
  performedByName      String?
  procedureDate        DateTime         @default(now())
  materialsUsed        String?
  procedureNotes       String?
  outcome              String?
  followUpInstructions String?
  status               String           @default("SCHEDULED") // SCHEDULED, IN_PROGRESS, COMPLETED, CANCELLED
  chargeGHS            Float            @default(0)
  createdAt            DateTime         @default(now())

  @@index([patientId])
}

model Referral {
  id                  String        @id @default(uuid())
  referralNumber      String        @unique
  patientId           String
  patient             Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId      String?
  consultation        Consultation? @relation(fields: [consultationId], references: [id])
  direction           String        @default("INTERNAL") // INTERNAL, EXTERNAL
  referringStaffName  String?
  receivingFacility   String?
  receivingDepartment String?
  reason              String
  clinicalSummary     String?
  urgency             String        @default("ROUTINE") // ROUTINE, URGENT, EMERGENCY
  status              String        @default("SENT") // SENT, ACCEPTED, COMPLETED, CANCELLED
  outcome             String?
  followUpDate        String?
  createdAt           DateTime      @default(now())

  @@index([patientId])
}

model Supplier {
  id             String          @id @default(uuid())
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  purchaseOrders PurchaseOrder[]
}

model PurchaseOrder {
  id           String              @id @default(uuid())
  poNumber     String              @unique
  supplierId   String
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  status       String              @default("ORDERED") // DRAFT, ORDERED, PARTIALLY_RECEIVED, RECEIVED, CANCELLED
  totalCost    Float               @default(0)
  notes        String?
  orderedBy    String?
  orderedAt    DateTime            @default(now())
  receivedAt   DateTime?
  items        PurchaseOrderItem[]
}

model PurchaseOrderItem {
  id              String        @id @default(uuid())
  purchaseOrderId String
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  medicineId      String
  medicine        Medicine      @relation(fields: [medicineId], references: [id])
  quantityOrdered Int
  quantityReceived Int          @default(0)
  unitCost        Float         @default(0)
}

model Ward {
  id          String               @id @default(uuid())
  name        String               @unique
  wardType    String               @default("GENERAL") // GENERAL, MATERNITY, PEDIATRIC, EMERGENCY, ISOLATION
  capacity    Int                  @default(10)
  isActive    Boolean              @default(true)
  beds        Bed[]
  admissions  InpatientAdmission[]
}

model Bed {
  id         String               @id @default(uuid())
  wardId     String
  ward       Ward                 @relation(fields: [wardId], references: [id], onDelete: Cascade)
  bedNumber  String
  status     String               @default("AVAILABLE") // AVAILABLE, OCCUPIED, MAINTENANCE, RESERVED
  admissions InpatientAdmission[]

  @@unique([wardId, bedNumber])
}

model InpatientAdmission {
  id                 String    @id @default(uuid())
  admissionNumber    String    @unique
  patientId          String
  patient            Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  wardId             String
  ward               Ward      @relation(fields: [wardId], references: [id])
  bedId              String?
  bed                Bed?      @relation(fields: [bedId], references: [id])
  admissionDiagnosis String
  admittingDoctor    String?
  status             String    @default("ADMITTED") // ADMITTED, TRANSFERRED, DISCHARGED
  admittedAt         DateTime  @default(now())
  dischargedAt       DateTime?
  dischargeSummary   String?

  @@index([patientId])
  @@index([status])
}

model InsuranceProvider {
  id           String             @id @default(uuid())
  code         String             @unique // e.g. NHIS, ACACIA, GLICO
  name         String
  providerType String             @default("PUBLIC") // PUBLIC, PRIVATE, CORPORATE
  contactPhone String?
  contactEmail String?
  isActive     Boolean            @default(true)
  createdAt    DateTime           @default(now())
  coverages    PatientInsurance[]
  claims       InsuranceClaim[]
}

model PatientInsurance {
  id                 String            @id @default(uuid())
  patientId          String
  patient            Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId         String
  provider           InsuranceProvider @relation(fields: [providerId], references: [id])
  membershipNumber   String
  policyNumber       String?
  coverageType       String            @default("STANDARD")
  expiryDate         String?
  verificationStatus String            @default("PENDING") // PENDING, VERIFIED, EXPIRED, INVALID
  isPrimary          Boolean           @default(true)
  createdAt          DateTime          @default(now())

  @@index([patientId])
}

model InsuranceClaim {
  id              String               @id @default(uuid())
  claimNumber     String               @unique
  patientId       String
  patient         Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  providerId      String
  provider        InsuranceProvider    @relation(fields: [providerId], references: [id])
  invoiceId       String?
  totalClaimedGHS Float                @default(0)
  approvedGHS     Float                @default(0)
  coPayGHS        Float                @default(0)
  status          String               @default("DRAFT") // DRAFT, SUBMITTED, APPROVED, PARTIALLY_APPROVED, REJECTED, PAID
  rejectionReason String?
  submittedAt     DateTime?
  settledAt       DateTime?
  createdAt       DateTime             @default(now())
  items           InsuranceClaimItem[]

  @@index([patientId])
  @@index([status])
}

model InsuranceClaimItem {
  id          String         @id @default(uuid())
  claimId     String
  claim       InsuranceClaim @relation(fields: [claimId], references: [id], onDelete: Cascade)
  description String
  amountGHS   Float
  approvedGHS Float          @default(0)
}
