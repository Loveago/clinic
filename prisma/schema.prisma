model PatientMedicalHistory {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  category       String   @default("CHRONIC") // CHRONIC, PAST_MEDICAL, SURGICAL, HOSPITALIZATION, FAMILY, SOCIAL, OCCUPATIONAL
  condition      String
  diagnosedDate  String?
  status         String   @default("ACTIVE") // ACTIVE, RESOLVED, MANAGED
  notes          String?
  recordedByName String?
  createdAt      DateTime @default(now())

  @@index([patientId])
}

model PatientMedicationHistory {
  id                    String   @id @default(uuid())
  patientId             String
  patient               Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  medicationName        String
  dosage                String?
  frequency             String?
  route                 String?  @default("Oral")
  startDate             String?
  endDate               String?
  prescriberName        String?
  status                String   @default("ACTIVE") // ACTIVE, COMPLETED, DISCONTINUED
  discontinuationReason String?
  createdAt             DateTime @default(now())

  @@index([patientId])
}

model PatientImmunization {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vaccineName       String
  dose              String?
  administeredDate  String
  batchNumber       String?
  administeredBy    String?
  nextScheduledDate String?
  notes             String?
  createdAt         DateTime @default(now())

  @@index([patientId])
}

model PatientConsent {
  id          String    @id @default(uuid())
  patientId   String
  patient     Patient   @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consentType String    // GENERAL_TREATMENT, SURGERY, DATA_SHARING, RESEARCH, TELEHEALTH, OTHER
  status      String    @default("GRANTED") // GRANTED, WITHDRAWN
  consentDate DateTime  @default(now())
  withdrawnAt DateTime?
  staffName   String?
  notes       String?
  documentId  String?
  createdAt   DateTime  @default(now())

  @@index([patientId])
}

model PatientVisit {
  id            String              @id @default(uuid())
  visitNumber   String              @unique // e.g. VIS-2026-0001
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitType     String              @default("OUTPATIENT") // OUTPATIENT, EMERGENCY, SCHEDULED, WALK_IN, FOLLOW_UP, REFERRAL
  departmentId  String?
  department    ClinicDepartment?   @relation(fields: [departmentId], references: [id])
  staffId       String?
  staff         ClinicStaffProfile? @relation(fields: [staffId], references: [id])
  status        String              @default("ACTIVE") // ACTIVE, IN_TRIAGE, IN_CONSULTATION, COMPLETED, DISCHARGED, CANCELLED
