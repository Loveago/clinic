  id                   String @id @default(uuid())
  courseId             String
  course               Course @relation("CoursePrerequisites", fields: [courseId], references: [id], onDelete: Cascade)
  prerequisiteCourseId String
  prerequisiteCourse   Course @relation("PrerequisiteFor", fields: [prerequisiteCourseId], references: [id], onDelete: Cascade)

  @@unique([courseId, prerequisiteCourseId])
}

model GradeScale {
  id          String   @id @default(uuid())
  name        String
  minScore    Float
  maxScore    Float
  gradeLetter String
  gradePoint  Float
  remark      String?
  isDefault   Boolean  @default(false)
  createdAt   DateTime @default(now())
}

model AssessmentComponent {
  id            String                    @id @default(uuid())
  courseId      String
  course        Course                    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  semesterId    String?
  name          String
  componentType String                    // ASSIGNMENT, QUIZ, MIDSEM, PRACTICAL, CLINICAL, FINAL_EXAM
  weightPercent Float
  maxMarks      Float                     @default(100)
  orderIndex    Int                       @default(1)
  sourceType    String?                   // ASSIGNMENT, EXAM, TOPIC_ASSESSMENT
  sourceId      String?
  autoSync      Boolean                   @default(true)
  createdAt     DateTime                  @default(now())

  scores        GradebookComponentScore[]

  @@index([courseId])
}

model GradebookComponentScore {
  id               String              @id @default(uuid())
  componentId      String
  component        AssessmentComponent @relation(fields: [componentId], references: [id], onDelete: Cascade)
  studentId        String
  student          Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  score            Float
  remarks          String?
  enteredById      String?
  isAutoCalculated Boolean             @default(false)
  updatedAt        DateTime            @updatedAt

  @@unique([componentId, studentId])
  @@index([studentId])
}


// =========================================================================
// COMPLETE CLINIC MANAGEMENT SYSTEM MODELS
// =========================================================================

model ClinicStaffProfile {
  id             String            @id @default(uuid())
  userId         String            @unique
  user           User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  clinicRole          String            // CLINIC_SUPER_ADMIN, CLINIC_ADMIN, RECEPTIONIST, DOCTOR, NURSE, MIDWIFE, PHARMACIST, LAB_TECH, RADIOLOGY_STAFF, CASHIER, RECORDS_OFFICER
  departmentId        String?
  department          ClinicDepartment? @relation(fields: [departmentId], references: [id])
  staffNumber         String?
  specialty           String?
  qualifications      String?
  licenseNumber       String?
  phone               String?
  scheduleDays        String?           // e.g. Mon,Tue,Wed,Thu,Fri
  employmentStatus    String            @default("ACTIVE") // ACTIVE, ON_LEAVE, SUSPENDED, INACTIVE
  canOverrideSchedule Boolean           @default(false)
  isActive            Boolean           @default(true)
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  appointments   Appointment[]
  queueEntries   ClinicQueue[]
  consultations  Consultation[]
  prescriptions  Prescription[]
  labRequests    LabRequest[]
  visits         PatientVisit[]
  triageRecords  TriageRecord[]
  nursingNotes   NursingNote[]
}

model Patient {
  id                     String            @id @default(uuid())
  patientNumber          String            @unique // e.g. WMC-PT-2026-0001
  userId                 String?           @unique
  user                   User?             @relation(fields: [userId], references: [id])
  fullName               String
  firstName              String?
  middleName             String?
  lastName               String?
  otherNames             String?
  dateOfBirth            String?
  gender                 String            @default("Female")
  maritalStatus          String?
  nationality            String?           @default("Ghanaian")
  preferredLanguage      String?           @default("English")
  photoUrl               String?
  ghanaCardNumber        String?
  phone                  String
  altPhone               String?
  email                  String?
  address                String?
  townCity               String?
  region                 String?
  ghanaPostGps           String?
  occupation             String?
  employer               String?
  bloodGroup             String?
  allergies              String?
  chronicConditions      String?
  emergencyName          String?
  emergencyPhone         String?
  emergencyRelation      String?
  nextOfKinName          String?
  nextOfKinPhone         String?
  nextOfKinRelation      String?
  preferredContactMethod String?           @default("Phone")
  referralSource         String?
  status                 String            @default("ACTIVE") // ACTIVE, INACTIVE, DECEASED, ARCHIVED, MERGED
  mergedIntoId           String?
  mergedAt               DateTime?
  registeredById         String?
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt

  appointments           Appointment[]
  queueEntries           ClinicQueue[]
  visits                 PatientVisit[]
  triageRecords          TriageRecord[]
  nursingNotes           NursingNote[]
  medicationAdmins       MedicationAdministration[]
  consultations          Consultation[]
  diagnoses              Diagnosis[]
  prescriptions          Prescription[]
  labRequests            LabRequest[]
  imagingRequests        ImagingRequest[]
  procedureRecords       ProcedureRecord[]
  referrals              Referral[]
  clinicalOrders         ClinicalOrder[]
  identifiers            PatientIdentifier[]
  allergyRecords         PatientAllergy[]
  medicalHistoryRecords  PatientMedicalHistory[]
  medicationHistory      PatientMedicationHistory[]
  immunizations          PatientImmunization[]
  consents               PatientConsent[]
  insurances             PatientInsurance[]
  insuranceClaims        InsuranceClaim[]
  inpatientAdmissions    InpatientAdmission[]
  invoices               ClinicInvoice[]
  payments               Payment[]
  documents              PatientDocument[]

  @@index([phone])
  @@index([fullName])
  @@index([ghanaCardNumber])
}

model ClinicQueue {
  id            String              @id @default(uuid())
  queueNumber   String              // e.g. Q-001
  queueDate     String              // YYYY-MM-DD (Africa/Accra)
  patientId     String
  patient       Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  appointmentId String?             @unique
  appointment   Appointment?        @relation(fields: [appointmentId], references: [id])
  departmentId  String?
  department    ClinicDepartment?   @relation(fields: [departmentId], references: [id])
  staffId       String?
  staff         ClinicStaffProfile? @relation(fields: [staffId], references: [id])
  visitId       String?
  visit         PatientVisit?       @relation(fields: [visitId], references: [id])
  stage         String              @default("RECEPTION") // RECEPTION, TRIAGE, CONSULTATION, LAB, IMAGING, PHARMACY, BILLING, DISCHARGED
  priority      String              @default("NORMAL") // NORMAL, URGENT, EMERGENCY
  priorityNotes String?
  status        String              @default("WAITING") // WAITING, CALLED, IN_CONSULTATION, COMPLETED, CANCELLED
  checkedInAt   DateTime            @default(now())
  calledAt      DateTime?
  startedAt     DateTime?
  completedAt   DateTime?
  consultation  Consultation?
  triageRecord  TriageRecord?

  @@unique([queueDate, queueNumber])
  @@index([queueDate, status])
  @@index([queueDate, stage])
  @@index([patientId])
}

model Consultation {
  id                 String                  @id @default(uuid())
  consultationNumber String                  @unique
  patientId          String
  patient            Patient                 @relation(fields: [patientId], references: [id], onDelete: Cascade)
  visitId            String?
  visit              PatientVisit?           @relation(fields: [visitId], references: [id])
  queueId            String?                 @unique
  queue              ClinicQueue?            @relation(fields: [queueId], references: [id])
  staffId            String?
  staff              ClinicStaffProfile?     @relation(fields: [staffId], references: [id])
  encounterType      String                  @default("OUTPATIENT") // OUTPATIENT, EMERGENCY, FOLLOW_UP, NURSING, MATERNAL, CHILD_HEALTH
  chiefComplaint     String
  hpi                String?                 // History of presenting illness
  medicalHistory     String?
  currentMedications String?
  allergies          String?
  clinicalNotes      String?
  examFindings       String?
  assessment         String?
  treatmentPlan      String?
  followUpDate       String?
  followUpNotes      String?
  internalNotes      String?                 // Restricted to authorized clinicians
  status             String                  @default("DRAFT") // DRAFT, SIGNED, COMPLETED, AMENDED
  signedAt           DateTime?
  signedByName       String?
  startedAt          DateTime                @default(now())
  completedAt        DateTime?
  createdAt          DateTime                @default(now())
  updatedAt          DateTime                @updatedAt

  vitals             VitalSign?
  diagnoses          Diagnosis[]
  prescriptions      Prescription[]
  labRequests        LabRequest[]
  imagingRequests    ImagingRequest[]
  procedureRecords   ProcedureRecord[]
  referrals          Referral[]
  clinicalOrders     ClinicalOrder[]
  formResponses      ClinicalFormResponse[]
  amendments         ConsultationAmendment[]
  invoices           ClinicInvoice[]

  @@index([patientId])
  @@index([visitId])
  @@index([status])
}

model ConsultationAmendment {
  id             String       @id @default(uuid())
  consultationId String
  consultation   Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  amendedById    String
  amendedByName  String
  reason         String
  changesJson    String
  createdAt      DateTime     @default(now())

  @@index([consultationId])
}

model VitalSign {
  id              String       @id @default(uuid())
  consultationId  String       @unique
  consultation    Consultation @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  bpSystolic      Int?
  bpDiastolic     Int?
  temperatureC    Float?
  pulseBpm        Int?
  respiratoryRate Int?
  spo2Percent     Int?
  weightKg        Float?
  heightCm        Float?
  bmi             Float?
  bloodGlucose    Float?
  painScore       Int?
  notes           String?
  recordedById    String?
  recordedAt      DateTime     @default(now())
}

model DiagnosisCatalog {
  id          String      @id @default(uuid())
  code        String      @unique // e.g. ICD-10 / Clinic Code
  name        String
  category    String?
  description String?
  isActive    Boolean     @default(true)
  diagnoses   Diagnosis[]
}

model Diagnosis {
  id             String            @id @default(uuid())
  consultationId String
  consultation   Consultation      @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientId      String
  patient        Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  catalogId      String?
  catalog        DiagnosisCatalog? @relation(fields: [catalogId], references: [id])
  code           String?
  title          String
  diagnosisType  String            @default("PRIMARY") // PRIMARY, SECONDARY, DIFFERENTIAL
  status         String            @default("ACTIVE") // ACTIVE, RESOLVED, RULED_OUT
  notes          String?
  isPrimary      Boolean           @default(false)
  recordedByName String?
  diagnosedAt    DateTime          @default(now())

  @@index([patientId])
  @@index([consultationId])
}

model Medicine {
  id            String          @id @default(uuid())
  name          String
  genericName   String?
  brandName     String?
  category      String          @default("General")
  description   String?
  dosageForm          String          @default("Tablet")
  strength            String?
  route               String?         @default("Oral")
  unit                String          @default("Unit")
  packageInfo         String?
  storageRequirements String?
  manufacturer        String?
  supplier            String?
  purchasePrice       Float           @default(0)
  sellingPrice        Float           @default(0)
  reorderLevel        Int             @default(10)
  isActive            Boolean         @default(true)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt

  batches             MedicineBatch[]
  movements           StockMovement[]
  rxItems             PrescriptionItem[]
  purchaseOrderItems  PurchaseOrderItem[]

  @@index([name])
}

model MedicineBatch {
  id                String             @id @default(uuid())
  medicineId        String
  medicine          Medicine           @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchNumber       String
  quantityReceived  Int
  quantityAvailable Int
  expiryDate        String             // YYYY-MM-DD
  purchaseDate      String             // YYYY-MM-DD
  supplier          String?
  unitCost          Float              @default(0)
  createdAt         DateTime           @default(now())

  movements         StockMovement[]
  dispensingRecords DispensingRecord[]

  @@unique([medicineId, batchNumber])
  @@index([expiryDate])
}

model StockMovement {
  id           String         @id @default(uuid())
  medicineId   String
  medicine     Medicine       @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  batchId      String?
  batch        MedicineBatch? @relation(fields: [batchId], references: [id])
  movementType String         // RECEIVE, DISPENSE, ADJUSTMENT, RETURN, EXPIRED_WRITEOFF, TRANSFER
  quantity     Int            // positive for inflow, negative for outflow
  reason       String?
  staffId      String?
  staffName    String?
  createdAt    DateTime       @default(now())

  @@index([medicineId])
}

model Prescription {
  id                 String              @id @default(uuid())
  prescriptionNumber String              @unique
  consultationId     String
  consultation       Consultation        @relation(fields: [consultationId], references: [id], onDelete: Cascade)
  patientId          String
  patient            Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  staffId            String?
  staff              ClinicStaffProfile? @relation(fields: [staffId], references: [id])
  notes              String?
  status             String              @default("ISSUED") // DRAFT, ISSUED, PARTIALLY_DISPENSED, DISPENSED, CANCELLED
  issuedAt           DateTime            @default(now())
  updatedAt          DateTime            @updatedAt

  items              PrescriptionItem[]

  @@index([patientId])
  @@index([status])
}

model PrescriptionItem {
  id                 String             @id @default(uuid())
  prescriptionId     String
  prescription       Prescription       @relation(fields: [prescriptionId], references: [id], onDelete: Cascade)
  medicineId         String?
  medicine           Medicine?          @relation(fields: [medicineId], references: [id])
  medicineName       String
  dosage             String
  frequency          String
  duration           String
  quantityPrescribed Int
  quantityDispensed  Int                @default(0)
  instructions       String?
  dispensingRecords  DispensingRecord[]

  @@index([prescriptionId])
}

model DispensingRecord {
  id                 String           @id @default(uuid())
  prescriptionItemId String
  prescriptionItem   PrescriptionItem @relation(fields: [prescriptionItemId], references: [id], onDelete: Cascade)
  batchId            String
  batch              MedicineBatch    @relation(fields: [batchId], references: [id])
  quantityDispensed  Int
  dispensedById      String?
  dispensedByName    String?
  dispensedAt        DateTime         @default(now())

  @@index([prescriptionItemId])
}

model LabTestCatalog {
  id                 String       @id @default(uuid())
  code               String       @unique
  name               String
  category           String       @default("Hematology")
  description        String?
  priceGHS           Float        @default(50.0)
  sampleType         String       @default("Blood")
  preparationNotes   String?
  turnaroundHours    Int          @default(24)
  referenceRangeText String?
  unit               String?
  isActive           Boolean      @default(true)
  createdAt          DateTime     @default(now())

  requests           LabRequest[]
}

model LabRequest {
  id                String              @id @default(uuid())
  requestNumber     String              @unique
  patientId         String
  patient           Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId    String?
  consultation      Consultation?       @relation(fields: [consultationId], references: [id])
  testId            String
  test              LabTestCatalog      @relation(fields: [testId], references: [id])
  requestedById     String?
  requestedBy       ClinicStaffProfile? @relation(fields: [requestedById], references: [id])
  clinicalNotes     String?
  priority          String              @default("ROUTINE") // ROUTINE, URGENT, STAT
  status            String              @default("REQUESTED") // REQUESTED, SAMPLE_COLLECTED, PROCESSING, COMPLETED, REVIEWED, CANCELLED
  sampleId          String?
  sampleStatus      String              @default("PENDING") // PENDING, COLLECTED, ACCEPTED, REJECTED
  rejectionReason   String?
  sampleCollectedAt DateTime?
  completedAt       DateTime?
  reviewedAt        DateTime?
  reviewedByName    String?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt

  result            LabResult?

  @@index([patientId])
  @@index([status])
}

model LabResult {
  id                    String     @id @default(uuid())
  labRequestId          String     @unique
  labRequest            LabRequest @relation(fields: [labRequestId], references: [id], onDelete: Cascade)
  resultValue           String
  unit                  String?
  referenceRange        String?
  flag                  String     @default("NORMAL") // NORMAL, ABNORMAL, CRITICAL
  componentsJson        String?
  observations          String?
  attachmentUrl         String?
  enteredById           String?
  enteredByName         String?
  verifiedByName        String?
  verifiedAt            DateTime?
  reviewedById          String?
  reviewedByName        String?
  correctionHistoryJson String?
  isReleased            Boolean    @default(false)
  enteredAt             DateTime   @default(now())
  reviewedAt            DateTime?
}

model ClinicInvoice {
  id             String              @id @default(uuid())
  invoiceNumber  String              @unique
  patientId      String
  patient        Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  consultationId String?
  consultation   Consultation?       @relation(fields: [consultationId], references: [id])
  title          String
  subtotal       Float               @default(0)
  discountAmount Float               @default(0)
  adjustmentNote String?
  totalAmount    Float               @default(0)
  amountPaid     Float               @default(0)
  balance        Float               @default(0)
  status         String              @default("UNPAID") // DRAFT, UNPAID, PARTIALLY_PAID, PAID, CANCELLED, REFUNDED
  notes          String?
  createdById    String?
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  items          ClinicInvoiceItem[]
  payments       Payment[]
  refunds        ClinicRefund[]

  @@index([patientId])
  @@index([status])
}

model ClinicInvoiceItem {
  id          String        @id @default(uuid())
  invoiceId   String
  invoice     ClinicInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  itemType    String        // CONSULTATION, LAB_TEST, MEDICINE, PROCEDURE, SERVICE
  referenceId String?
  description String
  quantity    Int           @default(1)
  unitPrice   Float
  totalPrice  Float

  @@index([invoiceId])
}

model ClinicRefund {
  id             String        @id @default(uuid())
  invoiceId      String
  invoice        ClinicInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  paymentId      String?
  amount         Float
  reason         String
  approvedById   String
  approvedByName String
  createdAt      DateTime      @default(now())

  @@index([invoiceId])
}

model PatientDocument {
  id             String   @id @default(uuid())
  patientId      String
  patient        Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title          String
  category       String   @default("MEDICAL_REPORT") // REFERRAL, LAB_ATTACHMENT, IMAGING_REPORT, MEDICAL_REPORT, CONSENT, DISCHARGE_SUMMARY, OTHER
  fileName       String
  mimeType       String
  fileSizeBytes  Int
  storagePath    String
  uploadedById   String?
  uploadedByName String?
  createdAt      DateTime @default(now())

  @@index([patientId])
}

