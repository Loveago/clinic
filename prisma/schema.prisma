  category       String    @default("MEDICATION") // MEDICATION, FOOD, ENVIRONMENTAL, OTHER
  reaction       String?
  severity       String    @default("MODERATE") // MILD, MODERATE, SEVERE, LIFE_THREATENING
  status         String    @default("ACTIVE") // ACTIVE, RESOLVED, UNKNOWN, NO_KNOWN_ALLERGIES
  recordedById   String?
  recordedByName String?
  recordedAt     DateTime  @default(now())
  resolvedAt     DateTime?
  notes          String?

