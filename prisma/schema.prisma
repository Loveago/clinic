}

model FeeStructure {
  id                String             @id @default(uuid())
  name              String
  programmeId       String
  programme         Programme          @relation(fields: [programmeId], references: [id], onDelete: Cascade)
  academicYear      String             @default("2025/2026")
  semester          String             @default("First Semester")
  level             String             @default("Level 100")
  studentCategory   String             @default("ALL") // NEW, CONTINUING, ALL
  admissionPeriodId String?
  admissionPeriod   AdmissionPeriod?   @relation(fields: [admissionPeriodId], references: [id])
  version           Int                @default(1)
  effectiveDate     String
  isActive          Boolean            @default(true)
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt

  items             FeeStructureItem[]
  invoices          Invoice[]

  @@index([programmeId, academicYear, semester, level])
}

model FeeStructureItem {
  id             String       @id @default(uuid())
  feeStructureId String
  feeStructure   FeeStructure @relation(fields: [feeStructureId], references: [id], onDelete: Cascade)
  feeCategoryId  String
  feeCategory    FeeCategory  @relation(fields: [feeCategoryId], references: [id])
  title          String
  amount         Float
  isOptional     Boolean      @default(false)
}

model Invoice {
  id             String              @id @default(uuid())
  invoiceNumber  String              @unique // e.g. INV-2025-001
  studentId      String
  student        Student             @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeStructureId String?
  feeStructure   FeeStructure?       @relation(fields: [feeStructureId], references: [id])
  title          String              // e.g. Level 100 Semester 1 Tuition & Clinical Fees
  amount         Float               // in GHS
  discountAmount Float               @default(0)
  amountPaid     Float               @default(0)
  balance        Float               // in GHS
  academicYear   String              @default("2025/2026")
  semester       String              @default("First Semester")
  dueDate        String
  status         InvoiceStatus       @default(UNPAID)
  notes          String?
  isLocked       Boolean             @default(false)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  payments       Payment[]
  items          InvoiceItem[]
  allocations    PaymentAllocation[]
  discounts      FeeDiscount[]
  paymentPlans   PaymentPlan[]
}

model InvoiceItem {
  id            String       @id @default(uuid())
  invoiceId     String
  invoice       Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
