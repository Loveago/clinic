model ClinicConfiguration {
  id                     String   @id @default("default")
  clinicName             String   @default("Action Boat Medical Centre")
  tagline                String   @default("Comprehensive Outpatient, Diagnostic & Family Healthcare")
  logoUrl                String?
  phone                  String   @default("+233 30 000 0000")
  email                  String   @default("clinic@actionhealth.edu.gh")
  address                String   @default("Accra, Ghana")
  operatingHours         String   @default("Mon - Sat: 07:30 - 20:00 | Emergency: 24/7")
  appointmentDurationMin Int      @default(30)
  invoicePrefix          String   @default("WMC-INV")
  invoiceFooterNote      String   @default("Thank you for choosing Action Boat Medical Centre.")
  triageCategoriesJson   String?  // Configurable triage levels
  workflowStagesJson     String?  // Configurable patient flow stages
  nhisEnabled            Boolean  @default(true)
  enableImaging          Boolean  @default(true)
  enableEmergency        Boolean  @default(true)
  enableInpatient        Boolean  @default(false)
