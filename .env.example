# ==============================================================================
# Action Boat Medical Centre & Action Health College (WellLife)
# Environment Variables Template (.env.example)
#
# Copy to `.env` for local development, or configure in:
# Vercel Dashboard -> Project -> Settings -> Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Database (PostgreSQL required for Vercel / Production)
# ------------------------------------------------------------------------------
# `prisma/schema.prisma` reads `url = env("DATABASE_URL")` (currently with
# `provider = "sqlite"` for local dev). Before deploying to Vercel, update
# `prisma/schema.prisma` to:
#   datasource db {
#     provider  = "postgresql"
#     url       = env("DATABASE_URL")
#     directUrl = env("DIRECT_URL")
#   }
#
# Pooled connection string used at runtime by Prisma Client (e.g. Neon, Supabase,
# Vercel/Prisma Postgres). Append `?sslmode=require` (or `&pgbouncer=true` if pooled).
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Direct (unpooled) connection string used by `prisma db push` / `prisma migrate`.
# Required by providers like Neon or Supabase when DATABASE_URL uses a pooler.
DIRECT_URL="postgresql://USER:PASSWORD@DIRECT_HOST:5432/DATABASE?sslmode=require"

# Local SQLite development alternative (only when prisma/schema.prisma uses sqlite):
# DATABASE_URL="file:./dev.db"

# ------------------------------------------------------------------------------
# 2. Authentication & Secrets (REQUIRED in Production)
# ------------------------------------------------------------------------------
# Used by `lib/auth.ts` to sign/verify session JWTs AND by `lib/ai-provider.ts`
# to derive the AES-256-GCM key for encrypting AI provider API keys in the DB.
# In `NODE_ENV=production`, the app throws if `JWT_SECRET` is not set.
# Generate a strong secret: `openssl rand -base64 48`
# WARNING: Changing this in production invalidates active sessions and stored AI keys.
JWT_SECRET="replace-with-a-strong-random-64-char-secret"

# Demo login guard (disabled by default in production):
# - Server-side: `/api/auth/demo-login` returns 403 in `NODE_ENV=production`
#   unless `ALLOW_DEMO_LOGIN="true"`.
# - Client-side: `app/auth/login/page.tsx`, `components/DemoRoleSwitcher.tsx`,
#   and `app/school/track/page.tsx` hide demo UI & sample refs in production
#   unless `NEXT_PUBLIC_ALLOW_DEMO_LOGIN="true"`.
# Keep both unset or "false" in production.
# ALLOW_DEMO_LOGIN="false"
# NEXT_PUBLIC_ALLOW_DEMO_LOGIN="false"

# ------------------------------------------------------------------------------
# 3. Application & Domain Configuration
# ------------------------------------------------------------------------------
# Vercel sets NODE_ENV="production" automatically during builds and runtime.
NODE_ENV="development"
PORT=3000

# Canonical public URL of your deployed app (no trailing slash).
# Also used by `lib/paystack.ts` as a fallback to build `PAYSTACK_CALLBACK_URL`
# (followed by Vercel's automatic `VERCEL_URL` system env var).
NEXT_PUBLIC_APP_URL="https://your-app.vercel.app"

# Institution branding & domain labels
NEXT_PUBLIC_APP_NAME="Action Boat Medical Centre & Action Health College"
NEXT_PUBLIC_CLINIC_DOMAIN="clinic.welllife.org"
NEXT_PUBLIC_SCHOOL_DOMAIN="school.welllife.org"

# ------------------------------------------------------------------------------
# 4. Payment Gateways — Paystack Ghana (GHS)
# ------------------------------------------------------------------------------
# Used in `lib/paystack.ts` and `app/api/payments/paystack/webhook/route.ts`.
# Leave as `sk_test_demo_...` only for local mock testing; use real `sk_test_`
# or `sk_live_` keys from the Paystack Dashboard in staging/production.
PAYSTACK_SECRET_KEY="sk_live_your_paystack_secret_key"
PAYSTACK_PUBLIC_KEY="pk_live_your_paystack_public_key"

# Full callback URL after Paystack checkout completes
PAYSTACK_CALLBACK_URL="https://your-app.vercel.app/portal/student/payments/callback"

# Webhook signing secret (HMAC SHA-512 of `x-paystack-signature`).
# Optional: `lib/paystack.ts` falls back to PAYSTACK_SECRET_KEY if unset.
PAYSTACK_WEBHOOK_SECRET="sk_live_your_paystack_secret_key"

# Optional / Reserved for future Flutterwave integration (not currently wired)
# FLUTTERWAVE_SECRET_KEY="FLWSECK_TEST-..."

# ------------------------------------------------------------------------------
# 5. AI PDF Processing & Auto-Grading Fallback (Optional)
# ------------------------------------------------------------------------------
# Used by `lib/ai-provider.ts` when no active AI provider is configured in
# Admin Panel -> Learning Materials -> AI Providers & Usage.
OPENAI_API_KEY="sk-your-openai-or-compatible-api-key"
OPENAI_BASE_URL="https://api.openai.com"
OPENAI_ENDPOINT="/v1/chat/completions"
OPENAI_MODEL="gpt-4o-mini"

# Optional metadata overrides read by `app/api/admin/ai-providers/route.ts`
# to display env-fallback status in the Admin AI Providers UI:
# AI_API_KEY="sk-your-openai-or-compatible-api-key"
# AI_API_BASE_URL="https://api.openai.com"
# AI_MODEL_NAME="gpt-4o-mini"

# ------------------------------------------------------------------------------
# 6. Verification Scripts (Local / CI Testing Only — Not Needed on Vercel)
# ------------------------------------------------------------------------------
# Used by `scripts/verify-*.js` when targeting a running server
# BASE_URL="http://127.0.0.1:3000"
